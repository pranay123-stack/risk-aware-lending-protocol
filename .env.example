# ---------------------------------------------------------------------------------------------
# Local defaults need NO .env at all. Copy to .env only to change ports or target a testnet.
# NEVER put a key that controls real funds in this file.
# ---------------------------------------------------------------------------------------------

# --- docker compose host ports (all bound to 127.0.0.1)
ANVIL_PORT=8545
PG_PORT=5475
API_PORT=4400
FRONTEND_PORT=3400
# Deploy + run the demo scenario on first start
RUN_DEMO=true

# --- services (when run outside docker)
RPC_URL=http://127.0.0.1:8545
DATABASE_URL=postgres://lending:lending@127.0.0.1:5475/lending
DATABASE_URL_TEST=postgres://lending:lending@127.0.0.1:5475/lending_test
DEPLOYMENT_FILE=../deployments/31337.json
CONFIRMATIONS=0            # indexer; defaults to 0 on Anvil, 3 elsewhere
MONITOR_INTERVAL_MS=10000
PRICE_KEEPER_ENABLED=true  # local chain only

# --- frontend (inlined at build time)
NEXT_PUBLIC_API_URL=http://localhost:4400
NEXT_PUBLIC_RPC_URL=http://localhost:8545
NEXT_PUBLIC_DEV_WALLETS=true

# --- OPTIONAL public testnet deployment (see docs/deployment.md)
# Use a FRESH key created for this purpose, funded only with faucet test ETH.
# Deploy.s.sol refuses to run with Anvil's public key on any chain other than 31337.
# DEPLOYER_PRIVATE_KEY=
# SEPOLIA_RPC_URL=
# FEEDS_MODE=mock            # or "chainlink" with the three feed addresses below
# ETH_USD_FEED=
# BTC_USD_FEED=
# USDC_USD_FEED=
# TIMELOCK_DELAY=86400
# GUARDIAN=
# TIMELOCK_PROPOSER=

# --- OPTIONAL fork test (read-only mainnet RPC, no keys)
# MAINNET_RPC_URL=
